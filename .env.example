# ルートのみ（/rest/v1 を含めない）
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_ONESIGNAL_APP_ID=98ab8b43-0536-4805-bee0-2341648828b6
# REST API Key は Edge Function `onesignal-push` のシークレットのみに設定（フロント不要）:
#   ONESIGNAL_REST_API_KEY
# DB トリガー用 Vault シークレット:
#   onesignal_push_webhook_url = https://<project>.supabase.co/functions/v1/onesignal-push
#   service_role_key = <service_role キー>
# 地図URLを本番ドメインで共有する場合（未設定時はブラウザの origin を使用）
# VITE_PUBLIC_APP_ORIGIN=https://concretelink.vercel.app
# プッシュ通知タップ時の Deep Link 先（Edge Function onesignal-push 用。通常は VITE_PUBLIC_APP_ORIGIN と同じ）
# supabase secrets set APP_BASE_URL=https://concretelink.vercel.app
