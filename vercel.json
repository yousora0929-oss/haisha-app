{
  "headers": [
    {
      "source": "/maplibre-gl-worker.mjs",
      "headers": [
        { "key": "Content-Type", "value": "text/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/maplibre-gl-shared.mjs",
      "headers": [
        { "key": "Content-Type", "value": "text/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/map-editor/:path*", "destination": "/MapEditor.html" },
    { "source": "/order/:path*", "destination": "/DispatchOrderPrototype.html" },
    { "source": "/mix-design/accept/:path*", "destination": "/MixDesignAccept.html" }
  ]
}
